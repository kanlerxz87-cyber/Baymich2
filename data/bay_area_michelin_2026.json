  "questions": [
    {"id": "Q1", "question": "Which 'Bay Area' definition should be used: the 9-county Bay Area (includes Napa and Sonoma), or Michelin's 'San Francisco and surroundings' listing?", "why": "Changes the star count from 29 to about 40+ and adds wine-country hotels.", "status": "Open"},
    {"id": "Q2", "question": "Should Michelin's 'Selected/Recommended' restaurants (86 in the SF listing; 323 statewide) be included, or only Stars and Bib Gourmands?", "why": "They make up most of the listings and need a separate verification pass.", "status": "Open"},
    {"id": "Q3", "question": "What meal and format should the price-for-two use: dinner, lunch, tasting menu or à la carte, and does it include tax and tip?", "why": "Restaurant prices vary a lot by format. Two adults at a 4-star tasting menu is very different from a Bib lunch.", "status": "Open"},
    {"id": "Q4", "question": "Which price source is acceptable: the restaurant's own menu page, or a booking platform (OpenTable, Resy, Tock) quote?", "why": "Each source gives different numbers and freshness. Affects how to label 'verified'.", "status": "Open"},
    {"id": "Q5", "question": "For hotels: what radius counts as 'around' a restaurant (e.g. 0.5 mi walk, 1 mi, 3 mi)? Should only Michelin-listed hotels count, or any hotel?", "why": "Hotel ranking cannot be computed until the radius and hotel pool are fixed.", "status": "Open"},
    {"id": "Q6", "question": "For social links: is an account acceptable only if the restaurant's own official website links to it (strict), or also if it is found by search (looser, with a flag)?", "why": "Strict is verifiable but returns fewer links.", "status": "Open"},
